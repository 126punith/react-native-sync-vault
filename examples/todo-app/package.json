{
  "name": "SyncVaultTodo",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "server": "CONTROL=1 TOKEN=demo-token node ../../server/express-sync-vault/example/todo-server.js",
    "pods": "cd ios && RCT_NEW_ARCH_ENABLED=1 bundle exec pod install",
    "e2e:build:ios": "detox build -c ios.sim.debug",
    "e2e:test:ios": "detox test -c ios.sim.debug",
    "e2e:build:android": "detox build -c android.emu.debug",
    "e2e:test:android": "detox test -c android.emu.debug"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-sync-vault": "file:../.."
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/eslint-config": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/typescript-config": "0.76.9",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.6",
    "detox": "^20.27.0",
    "eslint": "^8.19.0",
    "express": "^4.22.3",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "ts-jest": "^29.1.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
