{
  "name": "react-native-sync-vault",
  "version": "2.0.0",
  "description": "A reliable offline-first sync vault for persistent network operations in React Native (New Architecture, Turbo Modules)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "codegen:check": "node scripts/codegen-check.js",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "prepare": "npm run build",
    "type-check": "tsc --noEmit",
    "cli": "node cli/index.js"
  },
  "keywords": [
    "react-native",
    "offline",
    "queue",
    "sync",
    "persistent",
    "sqlite",
    "offline-first",
    "api-interception",
    "fetch-interceptor",
    "automatic-sync"
  ],
  "author": "Punith M <punithm300@gmail.com>",
  "license": "MIT",
  "bin": {
    "sync-vault-init": "./cli/index.js"
  },
  "files": [
    "lib",
    "src",
    "android",
    "!android/build",
    "ios",
    "schema",
    "cli",
    "react-native-sync-vault.podspec",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "codegenConfig": {
    "name": "RNSyncVaultSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.syncvault"
    }
  },
  "devDependencies": {
    "@testing-library/react-hooks": "^8.0.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "express": "^4.22.3",
    "jest": "^29.0.0",
    "react": "^18.3.1",
    "react-native": "^0.76.9",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/126punith/react-native-sync-vault.git"
  }
}
